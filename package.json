{
  "name": "dsh-unified-router",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/web-host.js",
  "license": "MIT",
  "displayName": "Unified Router",
  "description": "Loomy、Raccoon、Qoder 中国版、TRAE、商汤 Token Plan、WorkBuddy、Agnes、云知声、AStudio、豆包工作、Coze 与 CodeArts 的模型、账号、额度与自动化管理：统一的 Web 设置页，仅 CN 版。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "model-router",
    "loomy",
    "raccoon",
    "qoder",
    "trae",
    "sensenova",
    "workbuddy",
    "agnes",
    "unisound",
    "astudio",
    "doubaowork",
    "coze",
    "codearts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-unified-router.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-unified-router#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-unified-router/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "vendor/sensenova-token-plan",
    "vendor/workbuddy",
    "vendor/channel-pack/LICENSE",
    "vendor/channel-pack/NOTICE.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/DESIGN-STANDARDS.md",
    "docs/APIKEY-CHANNELS.md",
    "docs/MANAGED-CHANNELS.md",
    "docs/QODER-CLI.md"
  ],
  "exports": {
    ".": "./lib/web-host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && npm run test:run",
    "test:run": "node --test test/backend.test.mjs test/host.test.mjs test/web-client.test.mjs test/model-selection-ui.test.mjs test/sensenova-manager.test.mjs test/sensenova-models.test.mjs test/plan-models-ui.test.mjs test/workbuddy.test.mjs test/model-rate-badge.test.mjs test/qoder-cli.test.mjs test/raccoon-thinking.test.mjs test/model-blacklist-hygiene.test.mjs test/apikey-providers.test.mjs test/apikey-llm.test.mjs test/apikey-models.test.mjs test/apikey-channel.test.mjs test/apikey-host.test.mjs test/apikey-client.test.mjs test/managed-channels.test.mjs test/automation-and-ux.test.mjs test/cot-loop-guard.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "undici": "8.11.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5 <0.3",
    "@deepseek-ai/schemastery": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0"
  }
}
